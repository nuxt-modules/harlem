{
  "name": "@nuxtjs/harlem",
  "version": "2.0.0",
  "license": "MIT",
  "description": "Harlem integration for Nuxt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuxt-modules/harlem.git"
  },
  "keywords": [
    "nuxt",
    "module",
    "nuxt-module",
    "harlem",
    "store"
  ],
  "author": {
    "name": "Daniel Roe <daniel@roe.dev>",
    "url": "https://github.com/danielroe"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/module.mjs"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build prepare && nuxt-module-build build",
    "prepack": "pnpm build",
    "dev": "nuxt dev playground",
    "dev:v5": "pnpm --filter harlem-module-playground-v5 dev",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground && pnpm --filter harlem-module-playground-v5 exec nuxt prepare",
    "release": "bumpp && npm publish && git push --follow-tags",
    "test:e2e": "vitest run test/e2e"
  },
  "dependencies": {
    "@harlem/core": "^3.1.8",
    "@harlem/plugin-devtools": "^3.1.8",
    "@harlem/plugin-ssr": "^3.1.8",
    "@nuxt/kit": "^4.6.0",
    "knitwork": "^1.1.0",
    "scule": "^1.3.0"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "1.17.0",
    "@nuxt/module-builder": "1.0.3",
    "@nuxt/schema": "4.6.2",
    "@nuxt/test-utils": "4.3.4",
    "@types/serve-static": "2.2.0",
    "@vitest/coverage-v8": "5.0.5",
    "bumpp": "12.3.0",
    "eslint": "10.12.0",
    "nuxt": "4.6.2",
    "playwright": "1.64.1",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  }
}
